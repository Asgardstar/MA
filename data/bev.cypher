CREATE (:functional_requirement {name: 'fr_sensor_monitoring', description: 'Must monitor steering angle, wheel speeds, yaw rate, and lateral acceleration.', definition_name: 'SensorMonitoringReq'});
CREATE (:functional_requirement {name: 'fr_stability_intervention', description: 'Shall intervene by reducing motor torque and/or applying individual wheel brakes.', definition_name: 'StabilityInterventionReq'});
CREATE (:functional_requirement {name: 'fr_trailer_stability', description: 'Must support trailer stability control.', definition_name: 'TrailerStabilityReq'});
CREATE (:functional_requirement {name: 'fr_driver_feedback', description: 'Shall provide driver feedback on ESP activation.', definition_name: 'DriverFeedbackReq'});
CREATE (:functional_requirement {name: 'fr_dual_braking', description: 'Must provide both hydraulic and regenerative braking.', definition_name: 'DualBrakingReq'});
CREATE (:functional_requirement {name: 'fr_abs_ebd', description: 'Shall support anti-lock braking (ABS) and electronic brake-force distribution (EBD).', definition_name: 'ABSandEBDReq'});
CREATE (:functional_requirement {name: 'fr_brake_integration', description: 'Must integrate with ESP and ADAS for coordinated interventions.', definition_name: 'BrakeSystemIntegrationReq'});
CREATE (:functional_requirement {name: 'fr_wear_feedback', description: 'Shall provide driver feedback on brake wear.', definition_name: 'WearFeedbackReq'});
CREATE (:functional_requirement {name: 'fr_adas_core', description: 'Must support adaptive cruise control, lane keeping, and emergency braking.', definition_name: 'ADASCoreFeaturesReq'});
CREATE (:functional_requirement {name: 'fr_safety_features', description: 'Shall provide blind spot detection and rear cross-traffic alert.', definition_name: 'SafetyFeaturesReq'});
CREATE (:functional_requirement {name: 'fr_navigation_integration', description: 'Must integrate with navigation and mapping systems.', definition_name: 'NavigationIntegrationReq'});
CREATE (:functional_requirement {name: 'fr_adas_ota', description: 'Shall enable over-the-air updates for ADAS algorithms.', definition_name: 'OTACapabilityReq'});
CREATE (:performance_requirement {name: 'pr_driving_range', description: 'Must achieve a minimum driving range of 400 km per charge.', definition_name: 'DrivingRangeReq'});
CREATE (:performance_requirement {name: 'pr_acceleration', description: 'Shall accelerate from 0–100 km/h in less than 8 seconds.', definition_name: 'AccelerationReq'});
CREATE (:performance_requirement {name: 'pr_top_speed', description: 'Must support a top speed of at least 160 km/h.', definition_name: 'TopSpeedReq'});
CREATE (:performance_requirement {name: 'pr_braking_distance', description: 'Shall provide a minimum braking distance of 40 m from 100 km/h.', definition_name: 'BrakingDistanceReq'});
CREATE (:performance_requirement {name: 'pr_peak_power', description: 'Must deliver a peak power output of at least 150 kW.', definition_name: 'PeakPowerReq'});
CREATE (:performance_requirement {name: 'pr_max_torque', description: 'Shall provide a maximum torque of 350 Nm.', definition_name: 'MaxTorqueReq'});
CREATE (:performance_requirement {name: 'pr_continuous_op', description: 'Must support continuous operation at 80% rated power for at least 30 minutes.', definition_name: 'ContinuousOperationReq'});
CREATE (:performance_requirement {name: 'pr_gradeability', description: 'Shall support a minimum gradeability of 20% at full load.', definition_name: 'GradeabilityReq'});
CREATE (:performance_requirement {name: 'pr_charge_rate', description: 'Shall support charge/discharge rates up to 4C for peak power events.', definition_name: 'ChargeDischargeRateReq'});
CREATE (:performance_requirement {name: 'pr_voltage_tolerance', description: 'Must maintain cell voltage within ±0.02 V tolerance.', definition_name: 'VoltageToleranceReq'});
CREATE (:performance_requirement {name: 'pr_thermal_runaway', description: 'Shall detect thermal runaway within 1 second.', definition_name: 'ThermalRunawayDetectionReq'});
CREATE (:performance_requirement {name: 'pr_cycle_life', description: 'Must support a battery cycle life of at least 1,500 full cycles.', definition_name: 'CycleLifeReq'});
CREATE (:performance_requirement {name: 'pr_battery_temp', description: 'Must maintain battery temperature between 15°C and 35°C during operation.', definition_name: 'BatteryTemperatureReq'});
CREATE (:performance_requirement {name: 'pr_preconditioning', description: 'Shall support rapid pre-conditioning before fast charging.', definition_name: 'PreConditioningReq'});
CREATE (:performance_requirement {name: 'pr_peak_cooling', description: 'Must achieve full battery pack cooling within 10 minutes after peak load.', definition_name: 'PeakLoadCoolingReq'});
CREATE (:performance_requirement {name: 'pr_control_loop', description: 'Control loop update rate must be at least 100 Hz.', definition_name: 'ControlLoopRateReq'});
CREATE (:performance_requirement {name: 'pr_diagnostics', description: 'Shall support real-time diagnostics and fault logging.', definition_name: 'DiagnosticsSupportReq'});
CREATE (:performance_requirement {name: 'pr_boot_time', description: 'Must achieve system boot time < 2 seconds.', definition_name: 'BootTimeReq'});
CREATE (:performance_requirement {name: 'pr_esp_response', description: 'Must react to loss of stability within 50 ms.', definition_name: 'ESPResponseTimeReq'});
CREATE (:performance_requirement {name: 'pr_rollover', description: 'Shall prevent vehicle rollover in emergency maneuvers.', definition_name: 'RolloverPreventionReq'});
CREATE (:performance_requirement {name: 'pr_speed_range', description: 'Must operate effectively at speeds from 0 to 200 km/h.', definition_name: 'SpeedRangeReq'});
CREATE (:performance_requirement {name: 'pr_stopping_distance', description: 'Maximum stopping distance from 100 km/h must not exceed 40 meters.', definition_name: 'StoppingDistanceReq'});
CREATE (:performance_requirement {name: 'pr_energy_recovery', description: 'Regenerative braking must recover at least 70% of available kinetic energy.', definition_name: 'EnergyRecoveryReq'});
CREATE (:performance_requirement {name: 'pr_brake_response', description: 'Brake response time must be < 50 ms.', definition_name: 'BrakeResponseTimeReq'});
CREATE (:performance_requirement {name: 'pr_detection_range', description: 'Object detection range must exceed 150 meters.', definition_name: 'DetectionRangeReq'});
CREATE (:performance_requirement {name: 'pr_lane_keeping', description: 'Lane keeping accuracy must be within 10 cm.', definition_name: 'LaneKeepingAccuracyReq'});
CREATE (:performance_requirement {name: 'pr_braking_activation', description: 'Emergency braking activation time must be < 100 ms.', definition_name: 'BrakingActivationReq'});
CREATE (:performance_requirement {name: 'pr_safety_compliance', description: 'Shall comply with ISO 26262 functional safety standards.', definition_name: 'SafetyComplianceReq'});
CREATE (:resource_requirement {name: 'rr_energy_consumption', description: 'Energy consumption must not exceed 16 kWh/100 km.', definition_name: 'EnergyConsumptionReq'});
CREATE (:resource_requirement {name: 'rr_material_compliance', description: 'Shall use materials compliant with environmental regulations.', definition_name: 'MaterialComplianceReq'});
CREATE (:resource_requirement {name: 'rr_powertrain_efficiency', description: 'Powertrain efficiency must exceed 90% under typical driving cycles.', definition_name: 'PowertrainEfficiencyReq'});
CREATE (:resource_requirement {name: 'rr_emi_emissions', description: 'Shall minimize electromagnetic interference (EMI) emissions.', definition_name: 'EMIEmissionsReq'});
